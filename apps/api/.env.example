PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
# Keep false for a fully local, no-external-request development experience.
# Public services are for light, single-instance prototype use only.
ENABLE_PUBLIC_APIS=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
# Set a real identifying project URL/contact before enabling public services.
PROVIDER_USER_AGENT=NaviFree/0.1 (local development)
# These are separate opt-ins. A token alone never enables Mapbox routing.
ENABLE_MAPBOX_ROUTING=false
MAPBOX_API_TOKEN=
